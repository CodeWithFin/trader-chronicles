# Trader Chronicles Sync Agent Configuration
# Copy to .env and fill in your values

# Web App Configuration
API_URL=https://your-domain.com
ACCOUNT_ID=your-account-uuid-from-web-app
AUTH_TOKEN=your-auth-token-from-web-app

# MetaTrader 5 Configuration
MT5_PATH=                          # Optional: path to terminal64.exe (auto-detect if empty)
MT5_LOGIN=12345678                 # Your MT5 account number
MT5_PASSWORD=your_mt5_password     # Your MT5 trading password
MT5_SERVER=JustMarkets-Live2       # Your broker server name

# Sync Configuration
SYNC_INTERVAL=5                    # Sync interval in minutes
AUTO_START=false                   # Start syncing automatically on launch
MINIMIZE_TO_TRAY=true              # Minimize to system tray on close